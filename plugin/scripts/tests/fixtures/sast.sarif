{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {"driver": {"name": "bandit", "version": "1.8.6", "rules": [
        {"id": "B105", "defaultConfiguration": {"level": "error"}},
        {"id": "B404", "defaultConfiguration": {"level": "note"}}
      ]}},
      "results": [
        {"ruleId": "B105", "message": {"text": "Possible hardcoded password"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/auth.py"}, "region": {"startLine": 12}}}]},
        {"ruleId": "B404", "message": {"text": "Consider possible security implications"},
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/run.py"}, "region": {"startLine": 3}}}]},
        {"ruleId": "B105", "level": "warning", "message": {"text": "suppressed one"},
         "suppressions": [{"kind": "inSource"}],
         "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/old.py"}, "region": {"startLine": 1}}}]}
      ]
    }
  ]
}
